# Public site URL
NEXT_PUBLIC_SITE_URL=https://www.lenaai.net

# Meta (Facebook) Pixel (defaults to 846747935139647 if unset)
NEXT_PUBLIC_META_PIXEL_ID=846747935139647

# API base URL (defaults to https://api.lenaai.net if unset)
NEXT_PUBLIC_API_BASE_URL=https://api.lenaai.net

# X-API-Key for /campaign/* routes. REQUIRED for sending messages.
# NEXT_PUBLIC_* vars are inlined at `next build` time, so this MUST be present
# in the production build environment (not just at runtime) or sends 401/403.
NEXT_PUBLIC_X_API_KEY=your_api_key_here
