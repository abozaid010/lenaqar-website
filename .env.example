# ─── Public vars (inlined into client bundle at `next build`) ─────────────────
# These ARE visible in the browser — never put secrets here.

# Public site URL
NEXT_PUBLIC_SITE_URL=https://lenaqar.com
NEXT_PUBLIC_SITE_BRAND=lenaqar
NEXT_PUBLIC_LENAQAR_TENANT_ID=homey
NEXT_PUBLIC_LENAQAR_FEED_ENABLED=true
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX
# LenaQar tenant CRM login (server-only). Used to persist public buy requests
# as leads + requirements without setting visitor session cookies.
# LENAQAR_CLIENT_EMAIL=
# LENAQAR_CLIENT_PASSWORD=

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=846747935139647

# Image/API hostname used for next/image remotePatterns (image loading, not API calls).
NEXT_PUBLIC_API_BASE_URL=https://api.lenaai.net
NEXT_PUBLIC_IMAGE_BASE_URL=https://api.lenaai.net


# ─── Server-only vars (never reach the browser) ───────────────────────────────
# Set these in your server environment / hosting platform secrets.
# Do NOT use NEXT_PUBLIC_ prefix — they must never be inlined into the client bundle.

# Backend API base URL used by server-side BFF proxy and API routes.
API_BASE_URL=https://api.lenaai.net

# X-API-Key for /public/*, /campaign/*, /whatsapp/* backend endpoints.
# Added server-side by the BFF catch-all — key never reaches the browser.
X_API_KEY=your_api_key_here

# JWT secret for BFF-signed match share tokens (fallback when backend is unreachable).
MATCH_SHARE_SECRET=change_me_in_production

# Shared secret between the Next.js BFF and the backend API.
# Generate with: openssl rand -hex 32
# Must match BFF_SECRET on the backend. Never use NEXT_PUBLIC_ prefix.
BFF_SECRET=generate_with_openssl_rand_hex_32

# Protects CloudAPI status routes used by GET /api/openwa/sessions/status:
#   GET {API_BASE_URL}/webhook/openwa/sessions/status
#   GET {API_BASE_URL}/webhook/openwa/session/status?session_id=…
# Must match OPENWA_SESSION_API_KEY on whatsapp-cloudapi. Sent as X-API-Key.
# Not OPENWA_API_KEY (that is CloudAPI → OpenWA REST only).
# Session IDs come from linked_automated_whatsapp in the authenticated profile.
OPENWA_SESSION_API_KEY=generate-a-long-random-secret-here
