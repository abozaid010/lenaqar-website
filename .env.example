# Public site
NEXT_PUBLIC_SITE_URL=https://www.lenaqar.com
NEXT_PUBLIC_LENAQAR_TENANT_ID=lenaqar
NEXT_PUBLIC_LENAQAR_FEED_ENABLED=true
# Public host of re-hosted unit videos (R2); only MP4/WebM from this host play inline.
NEXT_PUBLIC_VIDEO_BASE_URL=https://video.lenaai.net

# Backend (server-only — required for /opportunities feed)
API_BASE_URL=https://api.lenaai.net
X_API_KEY=
# Legacy name still read by apiConfig if X_API_KEY is unset:
# NEXT_PUBLIC_X_API_KEY=
# Required on Vercel — backend returns 403 for serverless egress without this:
BFF_SECRET=

# Homepage requirements use GET /public/v1/requirements (X-API-Key only).
# Do not set CRM username/password on this site.

