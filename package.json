{
  "name": "lenaqar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096 --no-deprecation' next dev --turbopack",
    "dev:trace-deprecations": "NODE_OPTIONS='--trace-deprecation' next dev",
    "prebuild": "npm rebuild lightningcss",
    "build": "NODE_OPTIONS='--max-old-space-size=1536' next build",
    "start": "NODE_OPTIONS='--max-old-space-size=512' next start",
    "lint": "next lint",
    "lint:seo": "node scripts/check-seo.js",
    "lint:all": "npm run lint && npm run lint:seo"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.8.4",
    "js-cookie": "^3.0.5",
    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^0.487.0",
    "next": "^16.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-phone-number-input": "^3.4.16",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.0.1",
    "@types/react": "19.2.7",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^4"
  }
}
